# Copy to .env and fill in. No secrets in the repository (NFR-SEC-05).
DATABASE_URL=postgres://n8e:n8e_dev_password@localhost:5432/n8e_collect
ADMIN_EMAIL=admin@n8elabs.com
ADMIN_PASSWORD=change-me
# Session cookie signing secret (generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
SESSION_SECRET=
# AWS (Phase 3+: uploads; Phase 4+: exports; Phase 5: backups, SES)
AWS_REGION=ap-south-1
S3_BUCKET=
SES_FROM="N8E Labs <collect@n8elabs.com>"
# Daily-rotating IP hash salt base — never store raw IPs (CLAUDE.md rule 9)
IP_HASH_SALT=
